  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 10 - Comparison Operator
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_comparison_operators
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: Comparison Operators
  image: {fileID: 0}
  description: "Comparison operators are used to compare two values.\nThey return
    a Boolean value: <color=#E57373>True</color> or <color=#E57373>False</color>.\n\n<font=\"JetBrainsMono
    SDF\"><color=#7FDFFF>==</color></font> \u2192 equal to\n<font=\"JetBrainsMono
    SDF\"><color=#7FDFFF>!=</color></font> \u2192 not equal to\n<font=\"JetBrainsMono
    SDF\"><color=#7FDFFF>></color></font> \u2192 greater than\n<font=\"JetBrainsMono
    SDF\"><color=#7FDFFF><</color></font> \u2192 less than\n<font=\"JetBrainsMono
    SDF\"><color=#7FDFFF>>=</color></font> \u2192 greater or equal\n<font=\"JetBrainsMono
    SDF\"><color=#7FDFFF><=</color></font> \u2192 less or equal\n\nExample:\n<font=\"JetBrainsMono
    SDF\"><color=#7FDFFF>condition</color> = <color=#55FF55>scan</color>() <color=#7FDFFF>==</color>
    <color=#FF6EC7>\"WhiteOre\"</color></font>\n\nIf the tile in front is \"WhiteOre\",
    then:\nthe value of <font=\"JetBrainsMono SDF\"><color=#7FDFFF>condition</color></font>
    is <color=#E57373>True</color>.\nOtherwise:\nthe value of <font=\"JetBrainsMono
    SDF\"><color=#7FDFFF>condition</color></font> is <color=#E57373>False</color>."
  isImageBig: 0
