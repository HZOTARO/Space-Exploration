  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 6 - Variablle Name
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_variable_name
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: Variable Name
  image: {fileID: 0}
  description: 'Variable naming rules:

    <indent=2em>- Must start with a letter
    or underscore ( <font="JetBrainsMono SDF">_</font> )

    - Cannot start with
    a number

    - Can only contain letters, numbers, and underscores

    - No
    spaces allowed

    - Should not use reserved keywords</indent>


    <color=#4CAF50>Correct
    naming examples:</color>

    <indent=1em><font="JetBrainsMono SDF">ore_count</font>,
    <font="JetBrainsMono SDF">target_z</font>, <font="JetBrainsMono SDF">is_path_clear</font></indent>


    <color=#FF6B6B>Wrong
    naming examples:</color>

    <indent=1em><font="JetBrainsMono SDF">1st_ore</font>
    (starts with a number)

    <font="JetBrainsMono SDF">target tile</font> (contains
    a space)

    <font="JetBrainsMono SDF"><color=#D96DD3>def</color></font> (reserved
    keyword)</indent>'
  isImageBig: 0
