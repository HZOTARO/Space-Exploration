  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 1 - Instructions
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_instruction
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: Instructions
  image: {fileID: 0}
  description: "A program is made from multiple instructions. Each line of code is
    considered an instruction.\nWhen the robot starts executing a program, it follows
    the instructions in order exactly as written.  \n\nChanging the order of instructions
    can produce completely different results.\nEach instruction must be written on
    its own line and cannot be stacked horizontally. One line equals one instruction.\n\nIn
    a program, we can also add comments to explain code.\nComments start with <font=\"JetBrainsMono
    SDF\"><color=#6A9955>#</color></font> and are ignored by the program.\n\nExample:\n<font=\"JetBrainsMono
    SDF\"><color=#6A9955># Move the robot forward</color></font>\n<font=\"JetBrainsMono
    SDF\"><color=#33CC66>move_forward</color>()</font>\n<font=\"JetBrainsMono SDF\"><color=#6A9955>#
    Turn left to change direction</color></font>\n<font=\"JetBrainsMono SDF\"><color=#33CC66>turn_left</color>()</font>\n<font=\"JetBrainsMono
    SDF\"><color=#6A9955># Collect the item in front</color></font>\n<font=\"JetBrainsMono
    SDF\"><color=#33CC66>collect</color>()</font>"
  isImageBig: 0
