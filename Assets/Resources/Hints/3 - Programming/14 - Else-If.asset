  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 14 - Else-If
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_elif
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: Elif
  image: {fileID: 0}
  description: 'Sometimes a program must check more than two possible conditions.


    The
    <font="JetBrainsMono SDF"><color=#D96DD3>elif</color></font> statement allows
    the program to test another condition if the previous <font="JetBrainsMono SDF"><color=#D96DD3>if</color></font>
    condition was false.


    Example:

    <indent=1em><font="JetBrainsMono SDF"><color=#D96DD3>if</color>
    tile <color=#D4D4D4>==</color> <color=#CE9178>"WhiteOre"</color>:</font>

    <indent=3em><font="JetBrainsMono
    SDF"><color=#33CC66>mine</color><color=#D4D4D4>()</color></font></indent>

    <font="JetBrainsMono
    SDF"><color=#D96DD3>elif</color> tile <color=#D4D4D4>==</color> <color=#CE9178>"Wall"</color>:</font>

    <indent=3em><font="JetBrainsMono
    SDF"><color=#33CC66>turn</color>(<color=#CE9178>"left"</color>)</font></indent>

    <font="JetBrainsMono
    SDF"><color=#D96DD3>else</color>:</font>

    <indent=3em><font="JetBrainsMono
    SDF"><color=#33CC66>move</color>(<color=#CE9178>"forward"</color>, <color=#B5CEA8>1</color>)</font></indent></indent>


    The
    program checks conditions from top to bottom. Once a condition is true, its code
    block is executed and the remaining conditions are skipped.'
  isImageBig: 0
