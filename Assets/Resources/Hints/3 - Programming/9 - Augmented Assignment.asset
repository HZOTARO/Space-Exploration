  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 9 - Augmented Assignment
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_augmented_assignment
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: Augmented Assignment
  image: {fileID: 0}
  description: "Augmented assignment is a shortcut for updating variable values using
    operators.\nIt combines an operation and assignment into one step.\n\nCommon
    forms:\n<font=\"JetBrainsMono SDF\"><color=#7FDFFF>+=</color></font> \u2192 add
    and assign\n<font=\"JetBrainsMono SDF\"><color=#7FDFFF>-=</color></font> \u2192
    subtract and assign\n<font=\"JetBrainsMono SDF\"><color=#7FDFFF>*=</color></font>
    \u2192 multiply and assign\n<font=\"JetBrainsMono SDF\"><color=#7FDFFF>/=</color></font>
    \u2192 divide and assign\n<font=\"JetBrainsMono SDF\"><color=#7FDFFF>//=</color></font>
    \u2192 floor divide and assign\n<font=\"JetBrainsMono SDF\"><color=#7FDFFF>%=</color></font>
    \u2192 modulo and assign\n<font=\"JetBrainsMono SDF\"><color=#7FDFFF>**=</color></font>
    \u2192 exponent and assign\n\nExample:\n<font=\"JetBrainsMono SDF\"><color=#7FDFFF>energy</color>
    = <color=#7FDFFF>10</color></font>\n<font=\"JetBrainsMono SDF\"><color=#7FDFFF>energy</color>
    += <color=#7FDFFF>5</color></font>\n\nEquivalent form:\n<font=\"JetBrainsMono
    SDF\"><color=#7FDFFF>energy</color> = <color=#7FDFFF>energy</color> + <color=#7FDFFF>5</color></font>"
  isImageBig: 0
