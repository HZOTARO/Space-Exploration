  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 3 - Commands
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_command
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: Commands
  image: {fileID: 0}
  description: "Commands are pre-programmed actions that allow the robot to perform
    specific tasks.\n\nA command is executed by writing its name followed by ().
    \nFor example: <font=\"JetBrainsMono SDF\"><color=#33CC66>move_forward</color>()</font>\n\nSome
    commands require additional information called parameters. Parameters are written
    inside the parentheses and are used to control how the command behaves. \nFor
    example: <font=\"JetBrainsMono SDF\"><color=#33CC66>discard</color>(<color=#B5CEA8>0</color>)</font>\n\nIn
    this example, <font=\"JetBrainsMono SDF\"><color=#33CC66>discard</color></font>
    is the command name, while <font=\"JetBrainsMono SDF\"><color=#B5CEA8>0</color></font>
    is the parameter representing the inventory slot index to discard.\n\nDifferent
    commands may require different types of parameters such as numbers or text depending
    on their purpose."
  isImageBig: 0
