  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 3 - Commands
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_command
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: Commands
  image: {fileID: 0}
  description: 'Commands are functions that allow the robot to perform specific actions
    and interact with the environment.


    Examples of command functions:

    <indent=2em>-
    <font="JetBrainsMono SDF"><color=#33CC66>collect</color><color=#D4D4D4>()</color></font></indent>

    <indent=2em>-
    <font="JetBrainsMono SDF"><color=#33CC66>scan</color><color=#D4D4D4>()</color></font></indent>


    Commands
    follow the same function rules and may also use parameters.


    Example:

    <indent=1em><font="JetBrainsMono
    SDF"><color=#33CC66>discard</color>(<color=#B5CEA8>0</color>)</font></indent>

    In
    this example: <font="JetBrainsMono SDF"><color=#33CC66>discard</color></font>
    is the command name and <font="JetBrainsMono SDF"><color=#B5CEA8>0</color></font>
    is the parameter representing the inventory slot index to discard'
  isImageBig: 0
