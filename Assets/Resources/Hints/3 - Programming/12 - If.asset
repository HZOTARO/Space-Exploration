  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 12 - If
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_if
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: If
  image: {fileID: 0}
  description: 'The <font="JetBrainsMono SDF"><color=#D291FF>if</color></font> statement
    is used to make decisions based on conditions.

    

    Format:

    <font="JetBrainsMono
    SDF"><color=#D291FF>if</color> condition:</font>

    <indent=2em><font="JetBrainsMono
    SDF">code</font></indent>


    If the condition is <font="JetBrainsMono SDF"><color=#55AAFF>True</color></font>,
    the code inside will be executed.

    If it is <font="JetBrainsMono SDF"><color=#55AAFF>False</color></font>,
    it will be skipped.


    Example:

    <font="JetBrainsMono SDF"><color=#D291FF>if</color>
    condition:</font>

    <indent=2em><font="JetBrainsMono SDF"><color=#55FF55>mine</color>()</font></indent>


    You
    can also use conditions directly:

    <font="JetBrainsMono SDF"><color=#D291FF>if</color>
    <color=#55FF55>scan</color>() == <color=#CE9178>"WhiteOre"</color>:</font>

    <indent=2em><font="JetBrainsMono
    SDF"><color=#55FF55>mine</color>()</font></indent>'
  isImageBig: 0
