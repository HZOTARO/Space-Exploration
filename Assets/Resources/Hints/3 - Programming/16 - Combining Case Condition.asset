  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 16 - Combining Case Condition
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_match_cont
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: Combining Case Condition
  image: {fileID: 0}
  description: 'Multiple cases can be combined into a single condition inside a <font="JetBrainsMono
    SDF"><color=#D96DD3>match</color></font> statement.

    This is useful when
    different values should perform the same action.


    Example:

    <indent=1em><font="JetBrainsMono
    SDF"><color=#D96DD3>match</color> tile:</font>

    <indent=2em><font="JetBrainsMono
    SDF"><color=#D96DD3>case</color> <color=#CE9178>"Wall"</color> <color=#55AAFF>or</color>
    <color=#CE9178>"BlackOre"</color>:</font>

    <indent=3em><font="JetBrainsMono
    SDF"><color=#33CC66>turn_left</color><color=#D4D4D4>()</color></font></indent>

    <font="JetBrainsMono
    SDF"><color=#D96DD3>case</color> <color=#D4D4D4">_</color>:</font>

    <indent=3em><font="JetBrainsMono
    SDF"><color=#33CC66>move_forward</color><color=#D4D4D4>()</color></font></indent></indent></indent>


    In
    this example, both <font="JetBrainsMono SDF"><color=#CE9178>"Wall"</color></font>
    and <font="JetBrainsMono SDF"><color=#CE9178>"BlackOre"</color></font> execute
    the same action.'
  isImageBig: 0
