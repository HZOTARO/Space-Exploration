  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 24 - Modify List
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_instruction tutorial_syntax tutorial_functions tutorial_command
    tutorial_data_types tutorial_variables tutorial_variable_name tutorial_arithmetic_operators
    tutorial_augmented_assignment tutorial_comparison_operators tutorial_logical_operators
    tutorial_if tutorial_indentation tutorial_else tutorial_elif tutorial_match tutorial_match_cont
