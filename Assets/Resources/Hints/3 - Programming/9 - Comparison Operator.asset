  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 9 - Comparison Operator
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_comparison_operators
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: Comparison Operators
  image: {fileID: 0}
  description: "Comparison operators are used to compare two values.\nThey return
    a Boolean value: <color=#55AAFF>True</color> or <color=#55AAFF>False</color>.\n<indent=2em><font=\"JetBrainsMono
    SDF\">==</font> \u2192 equal to\n<font=\"JetBrainsMono SDF\">!=</font> \u2192
    not equal to\n<font=\"JetBrainsMono SDF\">> </font> \u2192 greater than\n<font=\"JetBrainsMono
    SDF\">< </font> \u2192 less than\n<font=\"JetBrainsMono SDF\">>=</font> \u2192
    greater or equal\n<font=\"JetBrainsMono SDF\"><=</font> \u2192 less or equal</indent>\nExample:\n<indent=1em><font=\"JetBrainsMono
    SDF\">condition = <color=#55FF55>scan</color>() == <color=#CE9178>\"WhiteOre\"</color></font></indent>\nIf
    the tile in front is <font=\"JetBrainsMono SDF\"><color=#CE9178>\"WhiteOre\"</color></font>,
    then the value of <font=\"JetBrainsMono SDF\">condition</font> is <color=#55AAFF>True</color>.Otherwise
    the value of <font=\"JetBrainsMono SDF\">condition</font> is <color=#55AAFF>False</color>."
  isImageBig: 0
