  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 7 - Variablle Name
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_variable_name
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: Variable Name
  image: {fileID: 0}
  description: "Variable naming rules:\r\n<indent=2em>\u2022 Must start with a letter
    or underscore ( _ )</indent>\r\n<indent=2em>\u2022 Cannot start with a number</indent>\r\n<indent=2em>\u2022
    Can only contain letters, numbers, and underscores</indent>\r\n<indent=2em>\u2022
    No spaces allowed</indent>\r\n<indent=2em>\u2022 Should not use reserved keywords</indent>\r\n\n<color=#4CAF50>Correct
    naming examples:</color>\r\n<font=\"JetBrainsMono SDF\">energy_level, currentTile,
    is_blocked</font>\r\n\n<color=#FF6B6B>Wrong naming examples:</color>\r\n<font=\"JetBrainsMono
    SDF\">1energy</font> (starts with a number)\n<font=\"JetBrainsMono SDF\">current
    tile</font> (contains a space)\n<font=\"JetBrainsMono SDF\">class</font> (reserved
    keyword)"
  isImageBig: 0
