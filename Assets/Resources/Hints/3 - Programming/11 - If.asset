  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 11 - If
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_if
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: If
  image: {fileID: 0}
  description: 'The <font="JetBrainsMono SDF"><color=#D96DD3>if</color></font> statement
    is used to make decisions based on condition.


    Format:

    <indent=1em><font="JetBrainsMono
    SDF"><color=#D96DD3>if</color> condition<color=#D4D4D4>:</color></font></indent>

    <indent=3em><font="JetBrainsMono
    SDF">code</font></indent>

    If the <font="JetBrainsMono SDF">condition</font>
    is <font="JetBrainsMono SDF"><color=#55AAFF>True</color></font>, the code inside
    will be executed.

    If it is <font="JetBrainsMono SDF"><color=#55AAFF>False</color></font>,
    it will be skipped.


    Example:

    <indent=1em><font="JetBrainsMono SDF"><color=#D96DD3>if</color>
    condition<color=#D4D4D4>:</color></font></indent>

    <indent=3em><font="JetBrainsMono
    SDF"><color=#33CC66>mine</color><color=#D4D4D4>()</color></font></indent>


    You
    can also use commands directly as conditions:

    <indent=1em><font="JetBrainsMono
    SDF"><color=#D96DD3>if</color> <color=#33CC66>scan</color><color=#D4D4D4>()</color>
    <color=#D4D4D4>==</color> <color=#CE9178>"WhiteOre"</color><color=#D4D4D4>:</color></font></indent>

    <indent=3em><font="JetBrainsMono
    SDF"><color=#33CC66>mine</color><color=#D4D4D4>()</color></font></indent>'
  isImageBig: 0
