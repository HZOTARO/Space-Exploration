  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 8 - Augmented Assignment
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_augmented_assignment
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: Augmented Assignment
  image: {fileID: 0}
  description: "Augmented assignment is a shortcut for updating variable values using
    operators.\nIt combines an operation and assignment into one step.\n<indent=2em><font=\"JetBrainsMono
    SDF\">+= </font> \u2192 add and assign\n<font=\"JetBrainsMono SDF\">-= </font>
    \u2192 subtract and assign\n<font=\"JetBrainsMono SDF\">*= </font> \u2192 multiply
    and assign\n<font=\"JetBrainsMono SDF\">/= </font> \u2192 divide and assign\n<font=\"JetBrainsMono
    SDF\">%= </font> \u2192 modulo and assign\n<font=\"JetBrainsMono SDF\">//=</font>
    \u2192 floor divide and assign\n<font=\"JetBrainsMono SDF\">**=</font> \u2192
    exponent and assign</indent>\nExample:\n<indent=1em><font=\"JetBrainsMono SDF\">energy
    = <color=#B5CEA8>10</color></font>\n<font=\"JetBrainsMono SDF\">energy += <color=#B5CEA8>5</color></font></indent>\nEquivalent
    form:\n<indent=1em><font=\"JetBrainsMono SDF\">energy = energy + <color=#B5CEA8>5</color></font></indent>"
  isImageBig: 0
