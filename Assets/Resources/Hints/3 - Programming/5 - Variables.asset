  m_Name: 5 - Variables
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_variables
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: Variables
  image: {fileID: 0}
  description: 'A variable is a named storage used in a program to hold a value.

    Variables
    allow you to store data such as numbers, text, or boolean values and reuse them
    later in your program.


    The = symbol is called assignment.

    It is used
    to store a value inside a variable.


    Example:

    <indent=1em><font="JetBrainsMono
    SDF">energy = <color=#B5CEA8>10</color></font>

    <font="JetBrainsMono SDF">tile
    = <color=#CE9178>"wall"</color></font>

    <font="JetBrainsMono SDF">is_blocked
    = <color=#55AAFF>True</color></font></indent>'
  isImageBig: 0
