  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 4 - Measure Distance
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_measure_distance
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: Measure Distance
  image: {fileID: 21300000, guid: a63870df74342e3409bc0de4aa5f8b0d, type: 3}
  description: 'The <font="JetBrainsMono SDF"><color=#33CC66>measure_distance</color>()</font>
    command measures the distance from the robot to the first tile in front of it
    that is not a floor.


    Instead of detecting what the object is, this command
    returns the number of tiles between the robot and the obstacle.


    Example:

    <indent=1em><font="JetBrainsMono
    SDF">distance <color=#D4D4D4>=</color> <color=#33CC66>measure_distance</color>()</font></indent>


    The
    returned value is a <font="JetBrainsMono SDF"><color=#4FC3F7>int</color></font>
    representing the distance to the first non-floor tile in front of the robot.'
  isImageBig: 0
