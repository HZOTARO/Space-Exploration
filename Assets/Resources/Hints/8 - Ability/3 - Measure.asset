  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 3 - Measure
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_measure
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: Measure
  image: {fileID: 0}
  description: 'The <font="JetBrainsMono SDF"><color=#55FF55>measure()</color></font>
    command reads the value of a resource tile in front of you.


    It returns
    a <color=#81C784>number</color> representing the value of the resource.


    If
    a tile cannot be measured, it returns: <font="JetBrainsMono SDF"><color=#7FDFFF>-1</color></font>


    Example:

    <font="JetBrainsMono
    SDF"><color=#7FDFFF>value</color> = <color=#55FF55>measure</color>()</font>

    <font="JetBrainsMono
    SDF"><color=#55FF55>print</color>(<color=#7FDFFF>value</color>)</font>


    You
    can use it with operators to combine values:

    <font="JetBrainsMono SDF"><color=#7FDFFF>value</color>
    = <color=#55FF55>measure</color>()</font>

    <font="JetBrainsMono SDF"><color=#7FDFFF>double_value</color>
    = <color=#55FF55>measure</color>() + <color=#7FDFFF>value</color></font>'
  isImageBig: 0
