  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 3 - Measure
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_measure
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: Measure
  image: {fileID: 21300000, guid: 85dbc9ce6acb4e6429c83d6222187304, type: 3}
  description: 'The <font="JetBrainsMono SDF"><color=#55FF55>measure</color>()</font>
    command reads the value of a resource tile directly in front of the robot.


    It
    returns an <font="JetBrainsMono SDF"><color=#4FC3F7>int</color></font> representing
    the value of that resource.

    If a tile cannot be measured, it returns: <font="JetBrainsMono
    SDF"><color=#B5CEA8>-1</color></font>


    Example:

    <indent=1em><font="JetBrainsMono
    SDF">value = <color=#55FF55>measure</color>()</font></indent>

    <indent=1em><font="JetBrainsMono
    SDF"><color=#F5F5AB>print</color>(value)</font></indent>


    You can also use
    it with operators to combine or compare values:

    <indent=1em><font="JetBrainsMono
    SDF">value = <color=#55FF55>measure</color>()</font></indent>

    <indent=1em><font="JetBrainsMono
    SDF">total = <color=#55FF55>measure</color>() + value</font></indent>'
  isImageBig: 0
