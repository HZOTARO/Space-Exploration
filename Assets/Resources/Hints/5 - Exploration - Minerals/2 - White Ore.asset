  hintId: tutorial_white_ore
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: White Ore
  image: {fileID: 21300000, guid: 459406bc49ee2964fb52c559997aa97f, type: 3}
  description: "White Ore is a mineral filled with energy. \nThe robot cannot move
    into a tile occupied by White Ore. Before the robot can pass through the tile
    or collect the resource, the ore must first be mined.\n\nTo break the ore, use
    the <font=\"JetBrainsMono SDF\"><color=#33CC66>mine</color><color=#D4D4D4>()</color></font>
    command.\nAfter mining the ore, use <font=\"JetBrainsMono SDF\"><color=#33CC66>collect</color><color=#D4D4D4>()</color></font>
    to store the resource inside the Inventory.\n\nExample:\n<indent=1em><font=\"JetBrainsMono
    SDF\"><color=#33CC66>mine</color><color=#D4D4D4>()</color></font>\n<font=\"JetBrainsMono
    SDF\"><color=#33CC66>collect</color><color=#D4D4D4>()</color></font></indent>"
  isImageBig: 0
