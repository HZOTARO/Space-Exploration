  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 3 - Purple Essence
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_purple_essence
  isUnlockedByDefault: 0
  ignoreLock: 0
  title: Purple Essence
  image: {fileID: 0}
  description: 'Purple Essence is a strange underground substance commonly found
    within Purple Veins.

    Because Purple Essence is located underground, the
    robot may safely move across a Purple Vein without interacting with it.


    To
    collect it, you must first use <font="JetBrainsMono SDF"><color=#33CC66>drill</color><color=#D4D4D4>()</color></font>
    on the Purple Vein to expose the essence beneath the surface.

    After the
    essence has been exposed, use <font="JetBrainsMono SDF"><color=#33CC66>pump</color><color=#D4D4D4>()</color></font>
    to extract it for collection.


    Example:

    <indent=1em><font="JetBrainsMono
    SDF"><color=#33CC66>drill</color><color=#D4D4D4>()</color></font>

    <font="JetBrainsMono
    SDF"><color=#33CC66>pump</color><color=#D4D4D4>()</color></font></indent>'
  isImageBig: 0
