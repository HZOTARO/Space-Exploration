  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 4 - Black Ore
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_black_ore
  isUnlockedByDefault: 0
  ignoreLock: 0
  title: Black Ore
  image: {fileID: 0}
  description: "Black Ore is a dangerous mineral that emits malicious energy and
    must be handled carefully.\n\nBefore mining it, the ore must first be purified
    using <font=\"JetBrainsMono SDF\"><color=#33CC66>purify</color><color=#D4D4D4>()</color></font>.\nAfter
    purification, Black Ore can be processed like other ores by using <font=\"JetBrainsMono
    SDF\"><color=#33CC66>mine</color><color=#D4D4D4>()</color></font> followed by
    <font=\"JetBrainsMono SDF\"><color=#33CC66>collect</color><color=#D4D4D4>()</color></font>.\n\nExample:\n<indent=1em><font=\"JetBrainsMono
    SDF\"><color=#33CC66>purify</color><color=#D4D4D4>()</color></font>\n<font=\"JetBrainsMono
    SDF\"><color=#33CC66>mine</color><color=#D4D4D4>()</color></font>\n<font=\"JetBrainsMono
    SDF\"><color=#33CC66>collect</color><color=#D4D4D4>()</color></font></indent>\n\nMining
    Black Ore without purifying it first will cause the ore to explode, damaging
    the robot and reducing the ore\u2019s value by half."
  isImageBig: 0
