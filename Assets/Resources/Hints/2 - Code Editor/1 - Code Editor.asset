  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 1 - Code Editor
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_code_editor
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: Code Editor
  image: {fileID: 0}
  description: "The Code Editor is used to write and execute programs for the robot.\r\n\r\nYou
    can use the <color=yellow>Play</color> button to continuously execute instructions
    from top to bottom until the program finishes or is interrupted.\r\n\nExecution
    can be <color=yellow>Paused</color> at any time to observe the robot\u2019s current
    state and behavior.\r\n\nUse <color=yellow>Abort</color> to stop the current
    execution and restart the program from the beginning.\r\n\r\nYou can also use
    <color=yellow>Step</color> to execute the program one instruction at a time."
  isImageBig: 0
