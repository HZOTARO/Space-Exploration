  hintId: tutorial_variable_watch
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: Variable Watch
  image: {fileID: 21300000, guid: 8ffdce728a699d64babe4f03b7e8854c, type: 3}
  description: 'Variable Watch allows you to monitor the values of variables during
    program execution.

    Like terminal, you can toggle the Variable Watch panel
    using the Variable Watch button.


    To configure tracked variables, open the
    Variable Panel and enter the variable names you want to display while the program
    runs.


    The watched values update in real time, making it useful for debugging,
    understanding program flow, and tracking how data changes over time.

    You
    can track a maximum of 5 variables at the same time.'
  isImageBig: 0
