  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 7 - Training 7
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_training_7
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: Automation
  image: {fileID: 0}
  description: 'In previous levels, you may have experienced writing repeating code
    for the same exact action.

    Writing the same instruction multiple times is
    tedious and makes your program hard to change.


    In this simulation, we will
    introduce <color=yellow>looping</color> to automate your instructions so they
    run multiple times automatically!

    The goal of this level is to reach the
    target by writing only one <font="JetBrainsMono SDF"><color=#33CC66>move</color>()</font>
    command.


    Example:

    <indent=1em><font="JetBrainsMono SDF"><color=#6A9955>#
    Instead of writing this:</color></font></indent>

    <indent=1em><font="JetBrainsMono
    SDF"><color=#33CC66>turn</color>(<color=#CE9178>"right"</color>)</font></indent>

    <indent=1em><font="JetBrainsMono
    SDF"><color=#33CC66>turn</color>(<color=#CE9178>"right"</color>)</font></indent>

    <indent=1em><font="JetBrainsMono
    SDF"><color=#33CC66>turn</color>(<color=#CE9178>"right"</color>)</font></indent>

    <indent=1em><font="JetBrainsMono
    SDF"><color=#6A9955># You can automate it like this!</color></font></indent>

    <indent=1em><font="JetBrainsMono
    SDF"><color=#D96DD3>for</color> i <color=#D96DD3>in</color> <color=#F5F5AB>range</color>(<color=#B5CEA8>3</color>):</font></indent>

    <indent=3em><font="JetBrainsMono
    SDF"><color=#33CC66>turn</color>(<color=#CE9178>"right"</color>)</font></indent>'
  isImageBig: 0
