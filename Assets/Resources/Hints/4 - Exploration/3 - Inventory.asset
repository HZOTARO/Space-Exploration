  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 3 - Inventory
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_inventory
  isUnlockedByDefault: 0
  ignoreLock: 1
  title: Inventory
  image: {fileID: 0}
  description: 'During exploration, you carry an <color=yellow>Inventory</color>
    that stores your collected resources.

    Each collected resource is displayed
    by its icon and its value.


    The Inventory has a limited number of slots,
    and each resource occupies exactly one slot.

    Collected resources will automatically
    fill empty slots in order from left to right.


    You can throw away a stored
    resource using the <font="JetBrainsMono SDF"><color=#33CC66>discard</color>(i)</font>
    command, where <font="JetBrainsMono SDF">i</font> is the index of the slot you
    want to empty. Just like a list, the inventory index starts from <font="JetBrainsMono
    SDF"><color=#B5CEA8>0</color></font>.


    Example:

    <indent=1em><font="JetBrainsMono
    SDF"><color=#6A9955># Discard the very first item in the inventory (Index 0)</color></font></indent>

    <indent=1em><font="JetBrainsMono
    SDF"><color=#33CC66>discard</color>(<color=#B5CEA8>0</color>)</font></indent>


    Note:
    There are separate Inventory capacities for Mineral Exploration and Material
    Exploration. Each can be upgraded independently to increase your maximum capacity!'
  isImageBig: 0
