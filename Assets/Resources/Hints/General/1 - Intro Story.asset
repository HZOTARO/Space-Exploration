MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 88f6fa2b89436164b8e97b17d82dc9a2, type: 3}
  m_Name: 1 - Intro Story
  m_EditorClassIdentifier: UtilityScriptIWrite::HintSO
  hintId: tutorial_welcome
  title: Welcome to Space Exploration!
  hintBlocks:
  - subtitle: System Online
    image: {fileID: 21300000, guid: 85f74dbebe129ad4c82fbf827ea2dd43, type: 3}
    description: 'Welcome to Space Exploration.


      You are a maintenance robot
      from a crashed exploration ship stranded on an unknown planet.


      Your
      main objective is to gather resources, repair damaged systems, and help restore
      the ship.'
  - subtitle: Your Mission
    image: {fileID: 0}
    description: 'The planet contains valuable materials that can be used for crafting,
      upgrades, and ship repairs.


      Explore different areas, collect resources,
      and complete tasks to unlock new systems and abilities.'
  - subtitle: Learn And Survive
    image: {fileID: 0}
    description: 'Many systems inside the ship are controlled through programming
      and logic mechanisms.

      

      By solving challenges and learning coding
      concepts, you will gradually recover the ship and continue the mission.'
  - subtitle: Good Luck
    image: {fileID: 0}
    description: 'Your crew is counting on you.


      Begin exploration, gather
      resources, and rebuild the future of the mission.'
  isUnlockedByDefault: 1
